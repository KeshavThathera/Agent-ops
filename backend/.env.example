# Copy to backend/.env and adjust. Never commit real secrets.

# development | demo | production
APP_ENV=demo

# Default: local SQLite file. For PostgreSQL (docker compose), use e.g.
# DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops
DATABASE_URL=sqlite:///./data/agentops.db

# Seeded demo accounts + one-click role switcher. Only enable in a demo environment.
DEMO_ACCOUNTS_ENABLED=true
DEMO_PASSWORD=demo-pass-2026

# Cookies: set COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:3000

# Background worker that advances workflows
WORKER_ENABLED=true

# ---- Live mode (optional). Without a key the app runs in demo mode only. ----
# The key is read on the server only; it is never sent to the browser or written to logs.
ANTHROPIC_API_KEY=
LLM_CLASSIFIER_MODEL=claude-haiku-5-5
LLM_PLANNER_MODEL=claude-opus-5-5
# Server-side refusal fallback for supported models (beta header server-side-fallback-2026-07-01)
LLM_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=60

# ---- Retrieval ----
# keyword = deterministic TF-IDF (offline, default)
# chroma  = ChromaDB vector search with its local all-MiniLM-L6-v2 ONNX model (~80 MB download on first use)
RETRIEVAL_BACKEND=keyword

MAX_UPLOAD_BYTES=5242880
